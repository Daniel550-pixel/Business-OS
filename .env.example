# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Durable execution runtime
# Point this at a trusted action gateway/adapter. Without it, external mutations fail closed.
EXECUTION_WEBHOOK_URL=""
# Optional HMAC-SHA256 secret for the execution adapter.
EXECUTION_WEBHOOK_SECRET=""
# Optional comma-separated target-system allowlist enforced by the server-side Policy Gate.
EXECUTION_ALLOWED_TARGETS=""
# Durable storage location for the append-only execution ledger.
BUSINESS_OS_DATA_DIR="./data"
# Large prompt runtime
# HTTP JSON body ceiling; keep this above the prompt ceiling to allow JSON overhead.
BUSINESS_OS_HTTP_BODY_LIMIT="2mb"
# Prompt validation ceiling used by server/promptRuntime.ts.
BUSINESS_OS_MAX_PROMPT_CHARS="1500000"
# Serialized business-context validation ceiling.
BUSINESS_OS_MAX_CONTEXT_CHARS="120000"

